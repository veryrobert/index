---
import Base from '../layouts/Base.astro'
---

<Base title="Page not found">
  <div class="pt-24 flex flex-col gap-4">
    <h1 class="text-3xl font-medium tracking-tight">Page not found</h1>
    <p class="text-sm text-muted-foreground">The page you're looking for doesn't exist.</p>
    <a href="/" class="text-sm text-muted-foreground hover:text-foreground transition-colors mt-2">← All projects</a>
  </div>
</Base>
