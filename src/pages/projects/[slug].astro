---
import Base from '../../layouts/Base.astro'
import { render } from 'astro:content'
import { getProjects, projectHref, projectHost, hasNotes, capitalise } from '../../lib/projects'

// Only projects with notes (their own markdown body or a fetched README) get a page.
export async function getStaticPaths() {
  const projects = await getProjects()
  return projects.filter(hasNotes).map(project => ({ params: { slug: project.id }, props: { project } }))
}

const { project } = Astro.props
const { Content } = await render(project)
const { title, description, tags, repo } = project.data
---

<Base title={title}>

  <div class="mb-8">
    <a href="/" class="text-xs text-muted-foreground hover:text-foreground transition-colors">← All projects</a>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-[1fr_200px] gap-16">

    <article>
      <h1 class="text-4xl md:text-5xl font-medium leading-tight tracking-tight mb-4 max-w-2xl">{title}</h1>
      {description && <p class="text-base text-muted-foreground mb-6 max-w-2xl">{description}</p>}
      <a href={projectHref(project)} data-local={project.data.local} class="inline-block text-sm text-foreground hover:text-foreground/70 transition-colors mb-12">
        Open <span data-host>{projectHost(project)}</span> ↗
      </a>

      <div class="prose prose-invert max-w-2xl
        prose-headings:font-medium prose-headings:tracking-tight
        prose-p:text-foreground/80 prose-p:leading-relaxed prose-p:text-base
        prose-a:text-foreground prose-a:underline prose-a:underline-offset-2
        prose-li:text-foreground/80
        prose-strong:text-foreground prose-strong:font-medium">
        <Content />
      </div>
    </article>

    <aside class="hidden lg:block">
      <div class="sticky top-20 flex flex-col gap-8">
        {tags.length > 0 && (
          <div>
            <p class="text-xs text-muted-foreground mb-3">Tags</p>
            <div class="flex flex-col gap-2">
              {tags.map(tag => (
                <a href={`/?tags=${tag}`} class="text-sm text-muted-foreground hover:text-foreground transition-colors">{capitalise(tag)}</a>
              ))}
            </div>
          </div>
        )}
        {repo && (
          <div>
            <p class="text-xs text-muted-foreground mb-3">Source</p>
            <a href={`https://github.com/${repo}`} class="text-sm text-muted-foreground hover:text-foreground transition-colors">{repo}</a>
          </div>
        )}
      </div>
    </aside>

  </div>

</Base>
