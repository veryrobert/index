---
import '../styles/global.css'
import Header from '../components/Header.astro'
import Sidebar from '../components/Sidebar.astro'
// import Footer from '../components/Footer.astro'

interface Props {
  title?: string
}
const { title = 'Index' } = Astro.props
---
<html lang="en" class="dark">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
</head>
<body class="bg-background text-foreground min-h-screen">

  <Header />

  <div class="flex pt-12 min-h-screen">
    <Sidebar />
    <main class="flex-1 md:ml-48 px-6 pt-6 pb-32">
      <slot />
    </main>
  </div>

  <!-- <Footer /> -->

  <script>
    // Viewed locally: project links go to the local .test sites instead of the live ones
    import { isLocalHost } from '../lib/projects-host'
    if (isLocalHost(location.hostname)) {
      document.querySelectorAll<HTMLAnchorElement>('a[data-local]').forEach(a => {
        a.href = a.dataset.local!
        const host = a.querySelector('[data-host]')
        if (host) host.textContent = new URL(a.dataset.local!).host
      })
    }
  </script>

</body>
</html>
